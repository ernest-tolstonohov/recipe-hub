extends ../layout

block content
    .container.page-container-narrow

        .section-header
            div
                h1 Edit Recipe
                p Update your recipe

        if error
            .error-banner #{error}

        form(method="POST" action=`/recipes/${recipe.id}/edit` enctype="multipart/form-data")

            //- ── BASIC INFO ──────────────────────────────────
            .form-section
                h2 Basic Info

                .form-row-single
                    .form-group
                        label(for="title") Title *
                        input#title(type="text" name="title" value=recipe.title required)

                    .form-group
                        label(for="description") Description
                        textarea#description(name="description" rows="3") #{recipe.description || ''}

                    .form-group
                        label Image
                        if recipe.image_url
                            input(type="hidden" name="existing_image_url" value=recipe.image_url)
                            .current-image-preview
                                img.current-img-thumb(src=recipe.image_url alt="Current image")
                                p.form-hint Upload a new image or paste a URL below to replace it
                        #upload-section.upload-section
                            .upload-area#upload-area
                                span.upload-icon 📷
                                p.upload-main Click to upload or drag & drop
                                p.upload-sub JPG, PNG, WEBP
                            #upload-preview.upload-preview(style="display:none")
                            input#recipe_image(type="file" name="recipe_image" accept=".jpg,.jpeg,.png,.webp" style="display:none")
                        #url-section.url-section(style="display:none")
                            input#image_url_input(type="url" name="image_url_input" placeholder="https://example.com/image.jpg")
                            img#url-preview-img.url-preview-img(style="display:none" alt="URL preview")
                        p.upload-toggle
                            a#switch-to-url(href="#") Or paste an image URL

                .form-row-4
                    .form-group
                        label(for="prep_time") Prep (min) *
                        input#prep_time(type="number" name="prep_time" value=recipe.prep_time min="1" required)

                    .form-group
                        label(for="cook_time") Cook (min) *
                        input#cook_time(type="number" name="cook_time" value=recipe.cook_time min="1" required)

                    .form-group
                        label(for="servings") Servings *
                        input#servings(type="number" name="servings" value=recipe.servings min="1" required)

                    .form-group
                        label(for="difficulty") Difficulty *
                        select#difficulty(name="difficulty" required)
                            option(value="" disabled) Select...
                            option(value="easy" selected=recipe.difficulty==='easy') Easy
                            option(value="medium" selected=recipe.difficulty==='medium') Medium
                            option(value="hard" selected=recipe.difficulty==='hard') Hard

            //- ── INGREDIENTS ─────────────────────────────────
            .form-section
                h2 Ingredients
                .ing-header-row
                    span Ingredient
                    span Qty
                    span Unit
                    span
                #ingredients-list
                    each ing in ingredients
                        .ingredient-row
                            .ing-name-wrap
                                input(type="text" name="ing_name" value=ing.name class="ing-name-input" autocomplete="off" placeholder="Ingredient name")
                                ul.ing-suggestions
                            input(type="number" name="ing_qty" value=ing.quantity class="ing-qty-input" min="0" step="0.01" placeholder="Qty")
                            input(type="text" name="ing_unit" value=ing.unit class="ing-unit-input" placeholder="Unit")
                            button.btn-remove-ing(type="button") ✕
                button#add-ingredient.btn-add-row(type="button") + Add Ingredient

            //- ── INSTRUCTIONS ────────────────────────────────
            .form-section
                h2 Instructions

                #steps-list
                    each step, idx in recipe.instructions
                        .step-row
                            .step-number #{idx + 1}
                            textarea(name=`step_${idx + 1}` rows="2") #{step}
                            button.btn-remove-step(type="button") ✕

                button#add-step.btn-add-row(type="button") + Add Step

            //- ── TAGS ────────────────────────────────────────
            .form-section
                h2 Tags

                - var dietary = tags.filter(t => t.type === 'dietary')
                - var mealTypes = tags.filter(t => t.type === 'meal_type')
                - var cuisines = tags.filter(t => t.type === 'cuisine')

                .tag-group
                    p.tag-group-label Dietary
                    .tags-wrap
                        each tag in dietary
                            label.tag-checkbox-label
                                input(type="checkbox" name="tags" value=tag.tag_id checked=selectedTagIds.includes(tag.tag_id))
                                span #{tag.name}

                .tag-group
                    p.tag-group-label Meal Type
                    .tags-wrap
                        each tag in mealTypes
                            label.tag-checkbox-label
                                input(type="checkbox" name="tags" value=tag.tag_id checked=selectedTagIds.includes(tag.tag_id))
                                span #{tag.name}

                .tag-group
                    p.tag-group-label Cuisine
                    .tags-wrap
                        each tag in cuisines
                            label.tag-checkbox-label
                                input(type="checkbox" name="tags" value=tag.tag_id checked=selectedTagIds.includes(tag.tag_id))
                                span #{tag.name}

            //- ── SUBMIT ──────────────────────────────────────
            .form-actions
                a.btn-cancel(href=`/recipes/${recipe.id}`) Cancel
                button.btn-green(type="submit") Save Changes

block scripts
    script(src="/js/recipe-form.js")
