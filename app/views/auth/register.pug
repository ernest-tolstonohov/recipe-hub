extends ../layout.pug

block content
  .auth-container
    h1 Create an Account
    
    if error
      p.error #{error}
    
    form(action='/register' method='POST')
      input(type='text' name='username' placeholder='Username' value=fields.username required)
      input(type='email' name='email' placeholder='Email' value=fields.email required)
      input(type='password' name='password' placeholder='Password' required)
      input(type='password' name='confirmPassword' placeholder='Confirm Password' required)
      button.btn.btn-green(type='submit') Register
      
    p Already have an account? 
      a(href='/login') Login here